<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- If you have .NET 8 installed instead of .NET 10, change this to net8.0 -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RiskRewardCalculator</RootNamespace>

    <!-- Trims unused IL and enables ahead-of-time friendly output for a smaller download -->
    <BlazorEnableCompression>true</BlazorEnableCompression>
    <RunAOTCompilation>false</RunAOTCompilation>

    <!-- Keeps the published output relocatable for static hosts like Vercel -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
